---
// Standalone layout for the /print routes — NO app chrome (sidebar, comments, write
// API). global.css supplies `.prose` typography; print.css (loaded after) forces a
// light palette + adds the @page rules; the inline @page below injects the page size
// + margin from config. Paged.js (lib/client/print.ts) paginates client-side.
import "../styles/global.css";
import "../styles/print.css";
import { assetExt, assetPath, contentTypeFor } from "../lib/asset-types";
import { withBase } from "../lib/base";
import { branding, clientI18n, pdf, siteName, theme } from "../config.mjs";
import { t } from "../i18n.mjs";

interface Props {
  title: string;
  /** Content locale of this print bundle (single-locale) — drives chrome + <html lang>. */
  locale?: string;
}
const { title, locale = clientI18n.defaultLocale } = Astro.props;
const m = t(locale);
// Same favicon as DocLayout (configured via branding, else the built-in mark).
const faviconHref = branding.favicon
  ? withBase(assetPath("favicon", branding.favicon))
  : "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232f6feb'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='19' font-weight='bold' text-anchor='middle' fill='white'%3EN%3C/text%3E%3C/svg%3E";
const faviconType = branding.favicon ? contentTypeFor(assetExt(branding.favicon)) : "image/svg+xml";
// Theme applies on /print too (fonts, radius, custom hooks) — but print.css overrides
// the color INTERNALS, so a theme can never darken the paper output.
const themeCssHref = theme.css ? withBase(assetPath("theme", theme.css)) : null;
---

<!doctype html>
<html lang={locale} data-nb-diagram-theme={theme.mermaid ? undefined : "plain"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteName}</title>
    <link rel="icon" type={faviconType} href={faviconHref} />
    <style is:inline set:html={`@page { size: ${pdf.pageSize}; margin: ${pdf.margin}; }`}></style>
    {/* Dual-theme Shiki (config `theme.code`): print.css forces `color-scheme: light`,
        so light-dark() resolves to the LIGHT code theme on paper — a light theme finally
        prints as a light block instead of the baked dark slab. */}
    {theme.codeCss && <style is:inline set:html={theme.codeCss} />}
    {themeCssHref && <link rel="stylesheet" href={themeCssHref} />}
    {theme.tokensCss && <style is:inline set:html={theme.tokensCss} />}
  </head>
  <body>
    <div class="pg-toolbar no-print">
      <button id="pg-print" type="button">{m.printSave}</button>
      <a href={withBase("/")}>← {m.pdfBack}</a>
      <span id="pg-status" class="pg-status">{m.loading}</span>
    </div>
    <main id="pg-content">
      <slot />
    </main>
    <script>
      import "../lib/client/print";
    </script>
  </body>
</html>
