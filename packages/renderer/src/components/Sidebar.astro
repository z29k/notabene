---
import { withBase } from "../lib/base";
import { buildNav, type Space } from "../lib/nav";
import NavLinks from "./NavLinks.astro";
import NavTree from "./NavTree.astro";
import { clientI18n, i18n, nav, roots } from "../config.mjs";
import { localizeField, routeFor } from "../lib/i18n-content.mjs";
import { navLabelId } from "../lib/nav-links.mjs";
import { visibleRoots } from "../lib/public-filter";
import { t } from "../i18n.mjs";

interface Props {
  current?: string;
  activeSpace?: Space;
  /** Content locale of the current page — the nav shows this locale only. */
  locale?: string;
  /** Aggregate pages: tag the per-locale `nav.sidebar` strings for the client applier. */
  relocalizeNav?: boolean;
}

const { current = "", activeSpace, locale = clientI18n.defaultLocale, relocalizeNav = false } = Astro.props;
const m = t(locale);
// Outbound links block (config `nav.sidebar`), under the space tree. The mobile drawer
// reuses this very DOM, so it costs no duplication there — unlike the topbar utils.
const sidebarTitle = localizeField(nav.sidebar.title, locale, i18n.defaultLocale) ?? null;
// One nav tree per space, filtered to the current locale (i18n) with clean prefixed hrefs.
const spaces = await Promise.all(
  visibleRoots(roots).map(async (root) => ({
    root,
    // Space title follows the rendered locale (per-locale `roots[].label`; string → verbatim).
    label: localizeField(root.labelI18n, locale, i18n.defaultLocale) ?? root.label,
    nodes: await buildNav(root.key, locale),
    home: routeFor({ space: root.key, id: "", locale }, i18n),
  })),
);
---

<div class="nav-filter">
  <input id="nav-filter" type="search" placeholder={m.sidebarFilter} autocomplete="off" />
</div>

<nav class="nav">
  {
    spaces.map(({ root, label, nodes, home }) => (
      <details class="space" open={!activeSpace || activeSpace === root.key}>
        <summary class="space-title">
          <span class="space-name">{label}</span>
          <span class="space-sub">{root.subLabel}</span>
        </summary>
        <p class="space-link"><a href={withBase(home)}>{m.sidebarOverview}</a></p>
        <NavTree nodes={nodes} current={current} />
      </details>
    ))
  }
</nav>

{
  nav.sidebar.links.length > 0 && (
    <nav class="nb-sidebar-links" aria-label={sidebarTitle ?? m.navLinks}>
      {sidebarTitle && (
        <p
          class="nb-sidebar-links-title"
          data-nb-nav-label={relocalizeNav && typeof nav.sidebar.title !== "string" ? navLabelId("sidebar", "title") : undefined}
        >
          {sidebarTitle}
        </p>
      )}
      <NavLinks items={nav.sidebar.links} section="sidebar" variant="sidebar" locale={locale} relocalize={relocalizeNav} />
    </nav>
  )
}

<script>
  // Client-side filter: hide leaves whose title doesn't match, and expand all
  // groups while searching.
  const input = document.getElementById("nav-filter") as HTMLInputElement | null;
  if (input) {
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      for (const a of document.querySelectorAll<HTMLElement>(".nav a[data-title]")) {
        const li = a.closest("li");
        if (!li) continue;
        const hit = !q || (a.dataset.title ?? "").toLowerCase().includes(q);
        li.style.display = hit ? "" : "none";
      }
      if (q) {
        for (const d of document.querySelectorAll<HTMLDetailsElement>(".nav details")) {
          d.open = true;
        }
      }
    });
  }
</script>
